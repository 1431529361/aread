# P0 在线基线凭据模板（复制为 .env.baseline.local 并填写；该后缀被 .gitignore 忽略）
# 用法：npm run test:online -- --env-file .env.baseline.local --suite all --repeat 3
# 安全：切勿提交真实密钥；运行器不打印密钥内容。

# 方式一：通用 OpenAI 兼容端点（推荐）
CUSTOM_API_ENDPOINT=https://your-endpoint/v1
CUSTOM_API_KEY=sk-your-key
AI_MODEL=your-chat-model
# 若该端点同时提供 embeddings，填写 Embedding 模型名以启用混合检索；留空则仅 BM25
EMBED_MODEL_NAME=

# 方式二：预置提供商（二选一即可）
# ZHIPU_API_KEY=...
# SILICONFLOW_API_KEY=...

# 可选：独立阿里云 Embedding（优先于通用端点 Embedding）
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_MODEL_NAME=text-embedding-v3
# EMBED_API_KEY=...