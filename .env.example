# AI 阅读助手 - 环境变量配置
# 复制此文件为 .env 并根据需要配置

# ========== 服务配置 ==========
# 服务端口（默认 3000）
PORT=3000

# 运行环境：development | production
# 生产环境会启用更严格的 CORS 策略
NODE_ENV=development

# ========== 安全密钥（强烈建议设置）==========
# 加密密钥：64位十六进制，用于加密存储API密钥
# 不设置则每次启动自动生成，重启后所有已加密的 API Key 将无法解密！
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# JWT 密钥：用于用户认证 token 签名
# 不设置则每次启动自动生成，重启后所有已签发的 token 将立即失效
JWT_SECRET=

# ========== 内置 AI 提供商（可选）==========
# 也可直接在 UI 中配置，UI 配置会优先
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=

# ========== 自定义 AI 提供商（可选）==========
# 当使用自定义提供商时填写
CUSTOM_API_KEY=
