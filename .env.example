# AI 阅读助手 - 环境变量配置
# 复制此文件为 .env 并根据需要配置

# ========== 服务配置 ==========
# 服务端口（默认 3000）
PORT=3000

# 加密密钥（64位十六进制，用于加密存储API密钥）
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# ========== 内置 AI 提供商 ==========
# 智谱AI API Key（可选）
ZHIPU_API_KEY=

# 硅基流动 API Key（可选）
SILICONFLOW_API_KEY=

# 默认 AI 模型（可选）
# AI_MODEL=glm-4-flash

# ========== 自定义 AI 提供商 ==========
# 自定义提供商的 API Key（当使用自定义提供商时填写）
CUSTOM_API_KEY=
