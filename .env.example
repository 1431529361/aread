# AI 阅读助手 - 环境变量配置
# 复制此文件为 .env 并根据需要配�?

# ========== 服务配置 ==========
# 服务端口（默�?3000�?
PORT=3000

# 加密密钥�?4位十六进制，用于加密存储API密钥�?
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# JWT��Կ (�������ã������û���֤)
JWT_SECRET=your_random_secret_at_least_32_chars_here

# ========== 内置 AI 提供�?==========
# 智谱AI API Key（可选）
ZHIPU_API_KEY=

# 硅基流动 API Key（可选）
SILICONFLOW_API_KEY=

# 默认 AI 模型（可选）
# AI_MODEL=glm-4-flash

# ========== 自定�?AI 提供�?==========
# 自定义提供商�?API Key（当使用自定义提供商时填写）
CUSTOM_API_KEY=

# ========== RAG 向量化（Embedding，可选） ==========
# 阿里云 Embedding 服务兜底配置（也可在前端“智能索引（RAG）”设置中按用户配置）
# OpenAI 兼容 Base URL，系统自动补全 /embeddings
EMBED_BASE_URL=
# Embedding 模型名称（需为 1024 维输出，如 text-embedding-v4）
EMBED_MODEL_NAME=
# 阿里云 API Key
EMBED_API_KEY=
