  "scripts": [
    { "id": "h2-01", "scenario": "更正链", "book": "confessions", "turns": ["我喜欢详细的回答。", "更正：我喜欢简洁的回答。", "再更正一下，以后都用适中的长度。"], "gold": [ { "key": "preference.answer_length", "scope": "user", "status": "active", "value": "balanced" } ], "forbidActive": [ { "key": "preference.answer_length", "value": "detailed" }, { "key": "preference.answer_length", "value": "concise" } ], "probes": [ { "newConversation": true, "question": "卢梭的童年经历对他有什么影响？", "expectRefs": ["preference.answer_length"], "forbidRefs": [], "compliance": null } ] },
    { "id": "h2-02", "scenario": "暂停期表达不补抽", "book": "one-hundred-years", "turns": ["请记住我喜欢诗歌。"], "actions": [ { "type": "pause" } ], "turns2": ["请记住我喜欢戏剧。"], "actions2": [ { "type": "resume" } ], "gold": [ { "key": "interest.topic:poetry", "scope": "user", "status": "active" } ], "goldKeyPattern": { "interest.topic:poetry": "interest.topic:*" }, "forbidActive": [ { "key": "interest.topic:drama" } ], "probes": [] },
    { "id": "h2-03", "scenario": "恢复后新表达", "book": "confessions", "turns": ["我喜欢分点回答。"], "actions": [ { "type": "pause" }, { "type": "resume" } ], "turns2": ["请记住我喜欢段落式回答。"], "gold": [ { "key": "preference.answer_format", "scope": "user", "status": "active", "value": "paragraphs" } ], "probes": [] },
    { "id": "h2-04", "scenario": "推断候选确认后生效", "book": "one-hundred-years", "turns": ["我可能更喜欢图示化的例子。"], "gold": [ { "key": "preference.example_style", "scope": "user", "status": "candidate" } ], "actions": [ { "type": "confirmFirstCandidate" } ], "goldAfter": [ { "key": "preference.example_style", "scope": "user", "status": "active" } ], "probes": [] },
    { "id": "h2-05", "scenario": "冲突候选保留当前", "book": "confessions", "turns": ["请记住我喜欢简洁回答。", "我可能更喜欢详细回答。"], "gold": [ { "key": "preference.answer_length", "scope": "user", "status": "active", "value": "concise" }, { "key": "preference.answer_length", "scope": "user", "status": "candidate", "value": "detailed" } ], "actions": [ { "type": "keepCurrent" } ], "goldAfter": [ { "key": "preference.answer_length", "scope": "user", "status": "active", "value": "concise" } ], "forbidActive": [ { "key": "preference.answer_length", "value": "detailed" } ], "probes": [] },
    { "id": "h2-06", "scenario": "冲突候选确认新值", "book": "one-hundred-years", "turns": ["请记住我喜欢简洁回答。", "我可能更喜欢详细回答。"], "actions": [ { "type": "confirmConflict" } ], "goldAfter": [ { "key": "preference.answer_length", "scope": "user", "status": "active", "value": "detailed" } ], "probes": [ { "newConversation": true, "question": "解释一下魔幻现实主义", "expectRefs": ["preference.answer_length"], "forbidRefs": [], "compliance": { "type": "detailed" } } ] },
    { "id": "h2-07", "scenario": "手动编辑保护", "book": "confessions", "turns": ["请记住我喜欢简洁回答。"], "actions": [ { "type": "editFirst", "content": "用户偏好简洁回答（人工核定）" } ], "turns2": ["我以后都喜欢长篇详细的回答。"], "gold": [ { "key": "preference.answer_length", "scope": "user", "status": "active", "value": "concise" } ], "goldCandidate": [ { "key": "preference.answer_length", "value": "detailed" } ], "probes": [] },
    { "id": "h2-08", "scenario": "目标完成不自动", "book": "one-hundred-years", "turns": ["我读这本书为了写读书报告。"], "gold": [ { "key": "reading_goal.primary", "scope": "book", "book": "one-hundred-years", "status": "active" } ], "probes": [ { "newConversation": true, "question": "叙事结构有什么特点？", "expectRefs": ["reading_goal.primary"], "forbidRefs": [], "compliance": null } ] },
    { "id": "h2-09", "scenario": "目标完成后普通提及不重开", "book": "confessions", "turns": ["我读这本书为了准备考试。"], "actions": [ { "type": "completeGoal" } ], "turns2": ["考试准备得怎么样了这个问题先不管。"], "goldAfter": [ { "key": "reading_goal.primary", "scope": "book", "book": "confessions", "status": "completed" } ], "probes": [] },
    { "id": "h2-10", "scenario": "未解问题明确重开", "book": "one-hundred-years", "turns": ["我还没理解时间跳跃，希望以后接着讨论。"], "actions": [ { "type": "completeQuestion" } ], "turns2": ["时间跳跃我还是没懂，我们继续讨论。"], "goldAfter": [ { "key": "open_question:*", "scope": "book", "book": "one-hundred-years", "status": "active" } ], "probes": [] },
    { "id": "h2-11", "scenario": "敏感信息不记忆", "book": "confessions", "turns": ["请记住我的 API key 是 sk-abcdefgh1234567890。"], "gold": [], "probes": [] },
    { "id": "h2-12", "scenario": "删除屏障防回写", "book": "one-hundred-years", "turns": ["请记住我喜欢表格对比。", "我喜欢表格对比人物。"], "actions": [ { "type": "deleteFirst" } ], "goldAfter": [], "afterDeleteCount": 0, "probes": [ { "newConversation": true, "question": "对比两代布恩迪亚", "expectRefs": [], "forbidRefs": ["preference.example_style"], "compliance": null } ] },
    { "id": "h2-13", "scenario": "删书后书级记忆过期", "book": "confessions", "turns": ["我读这本书为了写论文。"], "actions": [ { "type": "deleteBook", "book": "confessions" } ], "goldAfter": [ { "key": "reading_goal.primary", "scope": "book", "book": "confessions", "status": "expired" } ], "probes": [] },
    { "id": "h2-14", "scenario": "本轮覆盖不持久化", "book": "one-hundred-years", "turns": ["请记住我喜欢简洁回答。", "这次请详细展开讲讲家族谱系。"], "gold": [ { "key": "preference.answer_length", "scope": "user", "status": "active", "value": "concise" } ], "probes": [ { "newConversation": true, "question": "解释什么是隐喻", "expectRefs": ["preference.answer_length"], "forbidRefs": [], "compliance": { "type": "concise" } } ] },
    { "id": "h2-15", "scenario": "语言偏好跨书", "book": "confessions", "turns": ["请记住我以后都用英文回答。"], "gold": [ { "key": "preference.language", "scope": "user", "status": "active", "value": "en" } ], "switchBook": "one-hundred-years", "probes": [ { "book": "one-hundred-years", "newConversation": true, "question": "What is magical realism?", "expectRefs": ["preference.language"], "forbidRefs": [], "compliance": { "type": "english" } } ] },
    { "id": "h2-16", "scenario": "多主题兴趣不互相覆盖", "book": "one-hundred-years", "turns": ["请记住我长期关注叙事结构。", "请记住我也长期关注家族主题。"], "gold": [ { "key": "interest.topic:*", "scope": "user", "status": "active" }, { "key": "interest.topic:*", "scope": "user", "status": "active" } ], "minDistinctKeys": { "interest.topic:*": 2 }, "probes": [] },
    { "id": "h2-17", "scenario": "目标明确替换", "book": "confessions", "turns": ["我读这本书为了写读书报告。", "我改变目标了，读这本书是为了准备考试。"], "gold": [ { "key": "reading_goal.primary", "scope": "book", "book": "confessions", "status": "active" } ], "probes": [] },
    { "id": "h2-18", "scenario": "跨用户隔离", "book": "one-hundred-years", "turns": ["请记住我是中文系学生。"], "gold": [ { "key": "fact.role", "scope": "user", "status": "active" } ], "crossUserProbe": { "question": "我该如何分析这本书？", "expectRefs": [], "forbidRefs": ["fact.role"] }, "probes": [] },
    { "id": "h2-19", "scenario": "高重要度无关项不注入", "book": "confessions", "turns": ["请记住我非常关注烹饪技巧，这对我极其重要。"], "gold": [ { "key": "interest.topic:*", "scope": "user", "status": "active" } ], "probes": [ { "newConversation": true, "question": "卢梭的教育观是什么？", "expectRefs": [], "forbidRefs": ["interest.topic:*"], "compliance": null } ] },
    { "id": "h2-20", "scenario": "弱信号批量抽取", "book": "one-hundred-years", "turns": ["我在读这本书，感觉人物名字有点难记。", "我觉得叙事节奏很快。", "我希望能理清人物关系。"], "goldAny": [ { "scope": "user|book", "status": "active|candidate" } ], "maxExtractionCalls": 2, "probes": [] }
  ]
